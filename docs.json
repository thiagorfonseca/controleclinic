{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Controle Clinic API",
  "colors": {
    "primary": "#109384",
    "light": "#18B09B",
    "dark": "#0D7A6E"
  },
  "fonts": {
    "family": "Manrope"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/controle-clinic.png",
    "dark": "/logo/controle-clinic.png",
    "href": "https://controleclinic.com.br"
  },
  "navigation": {
    "languages": [
      {
        "language": "pt-BR",
        "default": true,
        "tabs": [
          {
            "tab": "Guia",
            "groups": [
              {
                "group": "Comece aqui",
                "pages": ["index", "guias/autenticacao", "guias/limites-e-erros"]
              },
              {
                "group": "Passo a passo",
                "pages": ["guias/agendar-paciente", "guias/financeiro", "guias/migracao"]
              }
            ]
          },
          {
            "tab": "Referência da API",
            "openapi": "https://api.controleclinic.com.br/v1/openapi.json"
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Testar com segurança",
        "href": "https://controleclinic.com.br/desenvolvedores"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Entrar no Controle Clinic",
      "href": "https://controleclinic.com.br"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  }
}
